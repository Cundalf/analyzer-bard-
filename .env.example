# ===== Bardo — ejemplo de configuración =====
# Copiá a .env y completá. NUNCA commitees .env.

# --- Subsonic / Navidrome (Módulo B) ---
SUBSONIC_URL=http://192.168.27.251:4533
SUBSONIC_USER=admin
SUBSONIC_PASS=cambiar

# --- Ollama (IA local) ---
# Para el CLI local: localhost. Para Docker: usá BARDO_OLLAMA_URL.
OLLAMA_URL=http://localhost:11434
# Solo Docker: URL de Ollama vista desde el contenedor
# (host.docker.internal apunta a tu máquina; o poné la IP del host)
BARDO_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=gemma4:cloud
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# --- Last.fm (opcional, crowd tags) ---
LASTFM_API_KEY=
ENABLE_LASTFM=false

# --- Módulo A / Janitor (requiere disco) ---
MUSIC_DIR=/ruta/a/tu/musica
DATA_DIR=./data
JANITOR_ENABLED=false
# API key gratis de https://acoustid.org/new-application
ACOUSTID_KEY=
# Ruta del config de beets si no usás el default ./beets-config/config.yaml
BEETS_CONFIG=
BEETS_BIN=
BEETSDIR=
# Backups de WAV antes de borrar (por defecto DATA_DIR/wav_originals)
WAV_BACKUP_DIR=
WAV_DELETE_ORIGINALS=false

# --- Detección de idioma por letra (offline, py3langid) ---
DETECT_LANGUAGE=true

# --- Análisis de audio real (BPM/key/energía; requiere MUSIC_DIR) ---
ANALYZE_AUDIO=false
AUDIO_ANALYSIS_SECONDS=30

# --- Comportamiento ---
EMBED_DIM=768
AGENT_ENABLED=true
AGENT_MAX_TOOL_CALLS=6
WEB_SEARCH_ENABLED=false
ENRICH_TRACKS_LLM=false
PLAYLIST_DEFAULT_SIZE=30
PLAYLIST_MAX_SIZE=100

# --- Web ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
